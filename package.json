{
  "name": "bali-bachelor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:types": "tsc --project tsconfig.tests.json --noEmit",
    "test:unit": "node --test tests/unit/*.test.*",
    "test:db": "node tests/database/run-database-normal-evidence.mjs",
    "test:db:failure": "node tests/database/run-rls-failure-injection.mjs",
    "test:db:cleanup": "node tests/database/assert-local-cleanup.mjs",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:browser:failure": "node tests/browser/run-failure-injection.mjs",
    "test:browser:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "test:evidence:manifest": "node tests/evidence/write-evidence-manifest.mjs",
    "test:ir002": "node tests/database/ir-002/run-tenant-foundation.mjs",
    "test:ir002:cleanup": "node tests/database/ir-002/assert-cleanup.mjs",
    "test:ir004": "node tests/database/ir-004/run-auth-profile-session.mjs",
    "test:ir004:cleanup": "node tests/database/ir-004/assert-cleanup.mjs",
    "test:ir004:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/browser/ir-004/auth-profile-session.spec.ts",
    "test:ir004:unit": "node --test tests/unit/ir-004-auth-profile-session.test.mjs",
    "test:ir004:evidence": "node tests/evidence/write-ir-004-evidence-manifest.mjs",
    "test:ir003": "node tests/database/ir-003/run-adversarial-bootstrap.mjs",
    "test:ir003:evidence": "node tests/database/ir-003/run-top-001-evidence.mjs",
    "test:tzref": "node tests/database/ir-002/verify-timezone-reference.mjs",
    "test:ir005:candidate": "node tests/database/ir-005/verify-invitation-candidates.mjs",
    "test:journey:live": "node tests/integration/run-live-journey.mjs",
    "test:journey:verify-email": "TRIP_VERIFY_EMAIL=1 node tests/integration/run-live-journey.mjs",
    "test:ir007": "npm run test:ir007:unit && npm run test:ir007:static && npm run test:ir007:evidence && npm run test:ir007:cleanup",
    "test:ir007:unit": "node --test tests/unit/ir-007-rls-ownership-matrix.test.mjs",
    "test:ir007:static": "node --test tests/unit/ir-007-static-contract.test.mjs",
    "test:ir007:evidence": "node tests/database/ir-007/run-rls-ownership-evidence.mjs",
    "test:ir007:cleanup": "node tests/database/ir-007/assert-cleanup.mjs",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:reset": "node scripts/dev-db.mjs reset",
    "db:types": "node scripts/dev-db.mjs types",
    "test:db:events": "node tests/database/trip-events/verify-trip-events.mjs",
    "test:crew:db": "node tests/database/crew/verify-crew-access.mjs",
    "test:crew:live": "node tests/integration/run-crew-live.mjs",
    "test:crew:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/browser/crew",
    "test:trip:db": "node tests/database/trip-todos/verify-trip-todos.mjs",
    "test:trip:live": "node tests/integration/run-trip-todos-live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "supabase": "2.105.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
